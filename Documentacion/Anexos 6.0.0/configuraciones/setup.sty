% Configuración GLOBAL de listings (se aplica a todos los bloques)
\lstset{
    basicstyle=\ttfamily\small,
    keywordstyle=\color{azulESCOM}\bfseries,
    stringstyle=\color{green!50!black},
    commentstyle=\color{gray}\itshape,
    breaklines=true,
    breakatwhitespace=true,
    frame=single,
    frameround=tttt,
    showstringspaces=false,
    tabsize=4,
    numbers=left,
    numberstyle=\tiny\color{gray},
    numbersep=5pt,
    xleftmargin=10pt,
    xrightmargin=5pt,
    backgroundcolor=\color{grayCode},
    rulecolor=\color{azulESCOM}
}

% Configuración específica para SQL
\lstdefinestyle{sqlstyle}{
    language=SQL,
    morekeywords={BIGSERIAL, TIMESTAMP, BOOLEAN, TEXT, VARCHAR}
}

% Configuración específica para Java
\lstdefinestyle{javastyle}{
    language=Java,
    morekeywords={Entity, Table, Id, GeneratedValue, GenerationType, 
                  Column, OneToMany, ManyToOne, JoinColumn, Data, 
                  NoArgsConstructor, AllArgsConstructor, Builder, 
                  LocalDateTime, FetchType, LAZY, CascadeType}
}

