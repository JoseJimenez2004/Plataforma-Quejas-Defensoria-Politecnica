  {}

\titleformat{\subsection}
  {\normalfont\large\bfseries\color{azulESCOM}}
  {\thesubsection}
  {1em}
  {}

\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries\color{azulESCOM}}
  {\thesubsubsection}
  {1em}
