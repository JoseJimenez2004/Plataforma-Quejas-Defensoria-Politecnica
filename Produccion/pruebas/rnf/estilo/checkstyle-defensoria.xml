<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Guía de estilo Java de la Plataforma de Quejas (TT 2026-B009)
  =============================================================
  Base: Google Java Style Guide (https://google.github.io/styleguide/javaguide.html)
  Desviaciones documentadas (ver pruebas/rnf/README.md, sección "Coding style"):
    D1. Sangría de 4 espacios (Google pide 2). Es la convención de Spring/IntelliJ y la
        que ya sigue el 96 % del código; cambiarla tocaría todas las líneas sin aportar.
    D2. Límite de 120 columnas (Google pide 100).
    D3. Se permite "_" en nombres de paquete (ipn.escom.defensoria.queja_service): lo
        genera Spring Initializr a partir del artifactId con guion.
    D4. El logger "log" puede ir en minúsculas aunque sea static final.

  Severidad:
    error   = regla OBLIGATORIA. Una violación rompe el pipeline (exit code > 0).
    warning = regla RECOMENDADA. Se reporta como deuda técnica, no rompe el pipeline.

  Compatible con Checkstyle 10.x.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <module name="SuppressWarningsFilter"/>

    <!-- 2.3.1 Espacios en blanco: solo espacios, nunca tabuladores -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
        <property name="severity" value="error"/>
    </module>

    <!-- 4.4 Límite de columnas (D2: 120) -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>

    <!-- Mantenibilidad: tamaño de archivo -->
    <module name="FileLength">
        <property name="max" value="800"/>
    </module>

    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>

        <!-- ===================== 2. Archivo fuente ===================== -->
        <!-- 2.1 El archivo se llama como su clase de nivel superior -->
        <module name="OuterTypeFilename">
            <property name="severity" value="error"/>
        </module>
        <!-- 2.3.3 Sin secuencias \uXXXX salvo caracteres no imprimibles -->
        <module name="AvoidEscapedUnicodeCharacters">
            <property name="allowEscapesForControlCharacters" value="true"/>
            <property name="allowByTailComment" value="true"/>
            <property name="allowNonPrintableEscapes" value="true"/>
        </module>

        <!-- ===================== 3. Estructura ===================== -->
        <!-- 3.3.1 Sin imports con comodín -->
        <module name="AvoidStarImport">
            <property name="severity" value="error"/>
        </module>
        <!-- 3.3.2 package e import nunca se parten en varias líneas -->
        <module name="NoLineWrap"/>
        <!-- 3.4.1 Exactamente una clase de nivel superior por archivo -->
        <module name="OneTopLevelClass">
            <property name="severity" value="error"/>
        </module>
        <!-- 3.4.2.1 Sobrecargas juntas -->
        <module name="OverloadMethodsDeclarationOrder"/>
        <module name="UnusedImports">
            <property name="severity" value="error"/>
        </module>
        <module name="RedundantImport"/>

        <!-- ===================== 4. Formato ===================== -->
        <!-- 4.1.1 Llaves siempre, aunque el bloque tenga una sola línea -->
        <module name="NeedBraces">
            <property name="severity" value="error"/>
        </module>
        <!-- 4.1.2 Estilo K&R: llave de apertura al final de la línea.
             Recomendada (no obligatoria): las ~80 violaciones son getters/setters de una
             sola línea en DTOs y entidades, p. ej. "public String getX() { return x; }". -->
        <module name="LeftCurly"/>
        <module name="RightCurly">
            <property name="id" value="RightCurlySame"/>
            <property name="tokens"
                      value="LITERAL_TRY, LITERAL_CATCH, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_DO"/>
        </module>
        <!-- 4.1.3 Bloques vacíos -->
        <module name="EmptyBlock">
            <property name="option" value="TEXT"/>
            <property name="tokens"
                      value="LITERAL_TRY, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_SWITCH"/>
        </module>
        <!-- 6.2 Excepciones capturadas: no se ignoran -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignorada|ignored"/>
            <property name="severity" value="error"/>
        </module>
        <!-- 4.2 Sangría (D1: 4 espacios) -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="braceAdjustment" value="0"/>
            <property name="caseIndent" value="4"/>
            <property name="throwsIndent" value="8"/>
            <property name="lineWrappingIndentation" value="8"/>
            <property name="arrayInitIndent" value="4"/>
            <property name="forceStrictCondition" value="false"/>
        </module>
        <!-- 4.3 Un enunciado por línea -->
        <module name="OneStatementPerLine">
            <property name="severity" value="error"/>
        </module>
        <!-- 4.6 Espacios en blanco -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
            <property name="ignoreEnhancedForColon" value="false"/>
        </module>
        <module name="WhitespaceAfter"/>
        <module name="MethodParamPad"/>
        <module name="ParenPad"/>
        <module name="GenericWhitespace"/>
        <module name="OperatorWrap">
            <property name="option" value="NL"/>
        </module>
        <module name="EmptyLineSeparator">
            <property name="allowNoEmptyLineBetweenFields" value="true"/>
            <property name="allowMultipleEmptyLines" value="false"/>
        </module>
        <!-- 4.8.2.1 Una variable por declaración -->
        <module name="MultipleVariableDeclarations">
            <property name="severity" value="error"/>
        </module>
        <!-- 4.8.3.2 Arreglos estilo Java: String[] args -->
        <module name="ArrayTypeStyle">
            <property name="severity" value="error"/>
        </module>
        <!-- 4.8.4 switch: default presente y sin caídas silenciosas -->
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <!-- 4.8.5 Anotaciones en su propia línea -->
        <module name="AnnotationLocation">
            <property name="allowSamelineMultipleAnnotations" value="false"/>
            <property name="allowSamelineSingleParameterlessAnnotation" value="true"/>
        </module>
        <!-- 4.8.7 Orden de modificadores (JLS) -->
        <module name="ModifierOrder">
            <property name="severity" value="error"/>
        </module>
        <!-- 4.8.8 Literales long con L mayúscula -->
        <module name="UpperEll">
            <property name="severity" value="error"/>
        </module>
        <module name="CommentsIndentation"/>

        <!-- ===================== 5. Nombres ===================== -->
        <!-- 5.2.1 Paquetes en minúsculas (D3: se permite "_") -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9_]*)*$"/>
            <property name="severity" value="error"/>
        </module>
        <!-- 5.2.2 Clases en UpperCamelCase -->
        <module name="TypeName">
            <property name="severity" value="error"/>
        </module>
        <!-- 5.2.3 Métodos en lowerCamelCase -->
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*(_[a-zA-Z0-9]+)*$"/>
            <property name="severity" value="error"/>
        </module>
        <!-- 5.2.4 Constantes en UPPER_SNAKE_CASE (D4: se permite log/logger) -->
        <module name="ConstantName">
            <property name="format" value="^(log|logger|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
        </module>
        <!-- 5.2.5 a 5.2.7 Campos, parámetros y variables locales en lowerCamelCase -->
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LambdaParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <!-- 5.2.8 Parámetros de tipo: T, E, o NombreT -->
        <module name="ClassTypeParameterName">
            <property name="format" value="(^[A-Z][0-9]?)$|([A-Z][a-zA-Z0-9]*[T]$)"/>
        </module>
        <module name="MethodTypeParameterName">
            <property name="format" value="(^[A-Z][0-9]?)$|([A-Z][a-zA-Z0-9]*[T]$)"/>
        </module>
        <!-- 5.3 Camel case: abreviaturas como palabras (HttpUrl, no HTTPURL) -->
        <module name="AbbreviationAsWordInName">
            <property name="ignoreFinal" value="false"/>
            <property name="allowedAbbreviationLength" value="3"/>
        </module>

        <!-- ===================== 6. Prácticas de programación ===================== -->
        <!-- 6.1 @Override siempre que aplique -->
        <module name="MissingOverride"/>
        <!-- 6.4 Sin finalize -->
        <module name="NoFinalizer">
            <property name="severity" value="error"/>
        </module>

        <!-- ===================== 7. Javadoc ===================== -->
        <!-- 7.3 Javadoc en tipos públicos (hoy ~50 %: recomendado) -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
            <property name="skipAnnotations" value="Generated"/>
        </module>
        <module name="JavadocParagraph"/>
        <module name="AtclauseOrder"/>
        <module name="NonEmptyAtclauseDescription"/>

        <!-- ===================== Métricas de mantenibilidad (ISO 25010) ===================== -->
        <module name="CyclomaticComplexity">
            <property name="max" value="15"/>
            <property name="switchBlockAsSingleDecisionPoint" value="true"/>
        </module>
        <module name="NPathComplexity">
            <property name="max" value="400"/>
        </module>
        <module name="MethodLength">
            <property name="max" value="80"/>
            <property name="countEmpty" value="false"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="8"/>
            <property name="ignoreOverriddenMethods" value="true"/>
            <property name="tokens" value="METHOD_DEF"/>
        </module>
        <module name="ClassFanOutComplexity">
            <property name="max" value="30"/>
        </module>
        <module name="NestedIfDepth">
            <property name="max" value="3"/>
        </module>

        <!-- ===================== Prácticas que también son de seguridad ===================== -->
        <!-- Nada de System.out / printStackTrace: todo pasa por el logger (RNF-Q04) -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="SinSystemOut"/>
            <property name="format" value="System\.(out|err)\.print|\.printStackTrace\(\)"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Usar el logger (SLF4J) en lugar de System.out/printStackTrace."/>
            <property name="severity" value="error"/>
        </module>
        <module name="IllegalCatch">
            <property name="illegalClassNames" value="Throwable, java.lang.Throwable, Error, java.lang.Error"/>
        </module>
        <module name="EqualsHashCode">
            <property name="severity" value="error"/>
        </module>
        <module name="StringLiteralEquality">
            <property name="severity" value="error"/>
        </module>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
    </module>
</module>
