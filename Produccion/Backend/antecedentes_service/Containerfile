FROM python:3.11-slim
WORKDIR /service
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    HF_HOME=/models HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 MODEL_OFFLINE=1 \
    TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 \
    OPENBLAS_NUM_THREADS=2 TORCH_NUM_THREADS=2 INDEX_TTL_SECONDS=300 \
    EMBEDDING_BATCH_SIZE=16
COPY requirements.txt .
# CPU-only PyTorch wheel; no CUDA runtime included.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch && \
    pip install --no-cache-dir -r requirements.txt
COPY app ./app
RUN useradd -u 10001 -m appuser && mkdir -p /models && chown appuser:appuser /models
USER appuser
EXPOSE 8080
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
