# PostgreSQL connection strings are secrets. Never commit the real .env.
SYSTEM_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
HISTORIC_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
MODEL_OFFLINE=1
HF_HOME=/models
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TORCH_NUM_THREADS=2
INDEX_TTL_SECONDS=300
INDEX_MAX_STALE_SECONDS=60
EMBEDDING_BATCH_SIZE=16
